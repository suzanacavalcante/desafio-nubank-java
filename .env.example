# Copie para .env (não versionado): cp .env.example .env
#
# Este arquivo é lido pelos DOIS lados:
#   - docker compose (cria o banco com estas credenciais e publica a porta)
#   - a aplicação (spring.config.import monta a URL de conexão a partir destas variáveis)
# Mude os valores aqui e as duas pontas continuam consistentes.
#
# FORMATO (os dois parsers interpretam o arquivo de forma diferente):
#   - sem aspas:   DB_PASSWORD=abc     (o Compose remove as aspas, o Spring NÃO: enviaria "abc" com aspas)
#   - sem export:  nada de "export DB_USER=..."
#   - sem comentário na mesma linha do valor (comentários só em linhas próprias, como estas)
#   - evite o caractere $ nos valores (o Compose o interpreta como variável)

DB_NAME=cadastro
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT=5434
# DB_HOST=localhost
