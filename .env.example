# Copie para .env (que não é versionado) e ajuste se precisar.
# Todos os valores abaixo já são os padrões do ambiente de desenvolvimento.

DB_NAME=cadastro
DB_USER=postgres
DB_PASSWORD=postgres
# Porta do host mapeada para o PostgreSQL do container
DB_PORT=5434

# Usada pela aplicação (precisa apontar para a mesma porta e banco acima)
DB_URL=jdbc:postgresql://localhost:5434/cadastro
