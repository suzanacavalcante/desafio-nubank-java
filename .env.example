# Copie para .env (não versionado): cp .env.example .env
#
# Este arquivo é lido pelos DOIS lados:
#   - docker compose (cria o banco com estas credenciais e publica a porta)
#   - a aplicação (spring.config.import monta a URL de conexão a partir destas variáveis)
# Mude os valores aqui e as duas pontas continuam consistentes.

DB_NAME=cadastro
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT=5434
# DB_HOST=localhost
